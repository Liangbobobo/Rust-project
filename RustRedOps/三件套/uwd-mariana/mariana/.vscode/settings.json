{
  "rust-analyzer.linkedProjects": [
    "Cargo.toml"
  ],
  "asm-code-lens.assembler": "masm (x86)",
  "files.associations": {
    "*.asm": "asm-intel-x86-generic",
    "*.inc": "asm-x86-masm"
  },
  "[asm-x86-masm]": {
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": false
    },
    "editor.wordBasedSuggestions": "matchingDocuments",
    "editor.suggestOnTriggerCharacters": true
  }
}
